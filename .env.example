# Callback to Kanonico DTF: POST /dtf/api/images/upscale/result
CALLBACK_URL=https://YOUR_DOMAIN/dtf/api/images/upscale/result
CALLBACK_SECRET=

# Optional: only allow these hosts for image_url (comma-separated)
# DOWNLOAD_ALLOWED_HOSTS=your-kanonico-domain.com

# Limits (aligned with Kanonico DTF)
MAX_INPUT_MB=20
MAX_INPUT_PIXELS=8000000

# Runtime
TMP_DIR=/tmp
WEIGHTS_DIR=/app/weights
TILE_SIZE=128
CALLBACK_TIMEOUT_SEC=120
DOWNLOAD_CONNECT_TIMEOUT_SEC=10
DOWNLOAD_READ_TIMEOUT_SEC=120
DOWNLOAD_MAX_REDIRECTS=3
